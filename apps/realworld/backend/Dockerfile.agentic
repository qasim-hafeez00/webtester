# [agentic] Reproducible build of the RealWorld Express/Prisma backend.
# (The upstream Dockerfile expects a prior host-side `nx build`.)
FROM node:20-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY src ./src
COPY tsconfig*.json ./
RUN npx prisma generate --schema src/prisma/schema.prisma \
    && npx esbuild $(find src -name '*.ts' -not -path 'src/tests/*' -not -name '*.d.ts') \
         --outdir=dist --outbase=src --platform=node --format=cjs --target=node20 --sourcemap \
    && cp -r src/assets dist/assets
COPY docker/entrypoint.sh /entrypoint.sh
RUN sed -i 's/\r$//' /entrypoint.sh && chmod +x /entrypoint.sh
ENV PORT=3000 NODE_ENV=production
EXPOSE 3000
CMD ["/entrypoint.sh"]
