# [agentic] Production build of the AutoE2E-instrumented Angular Conduit,
# served by nginx on the same origin as the API (/api -> backend).
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json ./
# "prepare" runs husky, which needs a .git directory.
RUN npm pkg delete scripts.prepare && npm ci --no-audit --no-fund
COPY . .
RUN npx ng build --configuration production --source-map

FROM nginx:1.27-alpine
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY docker/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/40-runtime-config.sh && chmod +x /docker-entrypoint.d/40-runtime-config.sh
COPY --from=build /app/dist/angular-conduit/browser /usr/share/nginx/html
