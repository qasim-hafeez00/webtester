# Copy to .env (gitignored) and fill in the key for the provider in configs/*.toml.
# Gemini free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional numbered fallbacks; rate limits and exhausted quotas rotate to the next key.
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
GEMINI_API_KEY_6=
GEMINI_API_KEY_7=
GEMINI_API_KEY_8=
GEMINI_API_KEY_9=
GEMINI_API_KEY_10=
# Groq free tier: https://console.groq.com/keys
GROQ_API_KEY=
# OpenRouter (free models available): https://openrouter.ai/keys
OPENROUTER_API_KEY=
